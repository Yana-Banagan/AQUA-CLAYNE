APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production must use HTTPS and disable debug output.
# APP_ENV=production
# APP_DEBUG=false
SANCTUM_EXPIRATION=43200
SANCTUM_TOKEN_PREFIX=ac_

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_SLOW_QUERY_MS=500
APP_SLOW_REQUEST_MS=2500

# OSRM-compatible routing server operated by Aqua Clayne or its provider.
# Leave unset in development to display live markers without a road route.
ROUTING_SERVICE_URL=

# Official Aqua Clayne delivery origin. Replace the initial Gatid reference pin
# with the station's verified map pin before production deployment.
STATION_ADDRESS="Aqua Clayne Water Refilling Station, Batisan, Gatid, Santa Cruz, Laguna"
STATION_LATITUDE=14.265111
STATION_LONGITUDE=121.405602

DB_CONNECTION=sqlite
DB_TIMEZONE=Asia/Manila
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use a verified SMTP provider in deployed environments. The `log` mailer is
# only for local development and does not send messages to customer inboxes.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Social OAuth Authentication (Google & Facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/social/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/v1/auth/social/facebook/callback"

# PayMongo Configuration (Store real keys in backend/.env only)
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=replace_with_paymongo_webhook_secret
PAYMONGO_API_URL=https://api.paymongo.com/v2
PAYMONGO_PAYMENT_METHOD_TYPES=gcash,paymaya,card
PAYMONGO_SUCCESS_URL="${APP_URL}/payment/paymongo/success"
PAYMONGO_CANCEL_URL="${APP_URL}/payment/paymongo/cancel"

